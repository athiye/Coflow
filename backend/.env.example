APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

CHEAP_PROVIDER=mock
MID_PROVIDER=openai_responses
PREMIUM_PROVIDER=openai_responses

CHEAP_MODEL=gpt-5-mini
MID_MODEL=gpt-5
PREMIUM_MODEL=gpt-5.4

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-key-here
ANTHROPIC_API_KEY=

ENABLE_TOOL_EXECUTION=true
MAX_TOOL_STEPS=8
ALLOW_SHELL_COMMANDS=true
ALLOWED_COMMAND_PREFIXES=python,python3,pytest,git,npm,pnpm,yarn,node,ruff,black,mypy,uv
COMMAND_TIMEOUT_SECONDS=30

COMPUTER_USE_ENABLED=true
COMPUTER_USE_HEADLESS=false
COMPUTER_USE_MAX_STEPS=12
COMPUTER_USE_SCREENSHOT_DIR=./computer_use_artifacts
